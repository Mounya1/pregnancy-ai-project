# Copy this file to .env and fill in your own key.
# .env is git-ignored - never put a real key in THIS file, it is committed.
OPENAI_API_KEY=sk-your-key-here

CHAT_MODEL=gpt-4o
VISION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
TTS_MODEL=tts-1
STT_MODEL=whisper-1
VECTOR_STORE_PATH=./vector_store

# Comma-separated origins allowed to call this API. Leave as * for local
# development; set it to your deployed web app's origin in production.
ALLOWED_ORIGINS=*
