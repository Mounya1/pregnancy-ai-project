# Secrets. The .env files hold live API keys - never commit them.
.env
*.env
!.env.example
backend/.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Generated at runtime
backend/generated_audio/*
!backend/generated_audio/.gitkeep

# Flutter / Dart
frontend/.dart_tool/
frontend/build/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

# Android signing - never commit these
frontend/android/key.properties
**/*.jks
**/*.keystore

# OS noise
.DS_Store
Thumbs.db
